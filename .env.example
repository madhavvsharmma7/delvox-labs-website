# Environment variables. Set these in the Vercel dashboard
# (Project → Settings → Environment Variables). For local function testing,
# put them in a gitignored .env and run `vercel dev` — plain `vite dev` does
# not serve /api, so both features fall back gracefully.

# Anthropic API key — used ONLY by /api/chat (the lead-qualifying chatbot).
# Never exposed to the browser.
ANTHROPIC_API_KEY=

# Resend API key — used ONLY by /api/contact (the trial/contact form email).
# Get one free at resend.com (3,000 emails/month, no card).
RESEND_API_KEY=

# The verified sender address for form emails. Verify delvoxlabs.com in Resend
# (Domains → add DNS records), then set this to a branded address, e.g.:
#   RESEND_FROM=Delvox Labs <noreply@delvoxlabs.com>
# Until the domain is verified, the default shared sender only delivers to your
# own Resend account email, so verifying the domain is required for real use.
RESEND_FROM=

# Where trial/contact leads are sent (defaults to info@delvoxlabs.com).
CONTACT_TO=
